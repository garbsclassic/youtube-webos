{
  "name": "youtube-webos",
  "version": "0.2.0",
  "description": "Ad-free YouTube app for webOS",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "package": "ares-package -n dist -o dist",
    "deploy": "node tools/deploy.js",
    "inspect": "ares-inspect youtube.leanback.v4",
    "launch": "ares-launch youtube.leanback.v4",
    "version": "node tools/sync-version.cjs && git add assets/appinfo.json",
    "prepare": "husky",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "lint": "eslint",
    "type-check": "tsc -b",
    "test": "node --import ./tools/register-node-esm-loader.mjs --test"
  },
  "repository": "github:garbsclassic/youtube-webos",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/garbsclassic/youtube-webos#readme",
  "dependencies": {
    "tiny-sha256": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/babel__core": "^7.20.5",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.19.2",
    "@webos-tools/cli": "^3.2.6",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.5",
    "cssnano": "^7.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-regexp": "^2.10.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^10.6.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
